# =============================================================================
# Oggy Reels Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=production          # development, staging, production
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR
TIMEZONE=UTC                # Your timezone for scheduling

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=oggy_bot
DB_USER=oggy
DB_PASSWORD=changeme_secure_password_here

# -----------------------------------------------------------------------------
# Redis (Celery broker / cache)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=             # Optional

# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
# Channel IDs to monitor (comma-separated)
# Find via: https://commentpicker.com/youtube-channel-id.php
YOUTUBE_CHANNEL_IDS=UC_xxxxxxxxxxxxxxxxx,UC_yyyyyyyyyyyyyyyyy

# -----------------------------------------------------------------------------
# Instagram Graph API
# -----------------------------------------------------------------------------
# Get from: https://developers.facebook.com/apps/
IG_APP_ID=your_app_id
IG_APP_SECRET=your_app_secret
IG_ACCESS_TOKEN=your_long_lived_access_token
IG_USER_ID=your_instagram_business_account_id
IG_PAGE_ID=your_facebook_page_id

# -----------------------------------------------------------------------------
# LLM for Metadata Generation
# -----------------------------------------------------------------------------
# Options: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini       # or claude-3-haiku, llama3.1:8b, etc.
LLM_BASE_URL=               # For Ollama: http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# Video Storage (Cloudflare R2 / AWS S3 compatible)
# -----------------------------------------------------------------------------
# Video files must be publicly accessible via HTTPS for Instagram
STORAGE_PROVIDER=r2         # r2, s3, local
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=oggy-reels
STORAGE_PUBLIC_URL=https://pub-xxxxxxx.r2.dev  # Public CDN URL

# -----------------------------------------------------------------------------
# Video Processing
# -----------------------------------------------------------------------------
CLIP_MIN_DURATION=15        # seconds
CLIP_MAX_DURATION=60        # seconds
CLIPS_PER_SOURCE=3          # How many clips to extract per source video
TARGET_RESOLUTION=1080x1920 # 9:16 for Reels
TARGET_FPS=30
VIDEO_CRF=22                # Quality (18-28, lower = better)
WATERMARK_PATH=             # Optional: path to watermark PNG
WATERMARK_OPACITY=0.3

# -----------------------------------------------------------------------------
# Scheduling (cron expressions)
# -----------------------------------------------------------------------------
DISCOVERY_SCHEDULE=0 */6 * * *      # Every 6 hours
POSTING_SCHEDULE=0 9,14,19 * * *    # 9AM, 2PM, 7PM UTC
CLEANUP_SCHEDULE=0 3 * * *          # Daily at 3AM

# -----------------------------------------------------------------------------
# Rate Limits & Safety
# -----------------------------------------------------------------------------
MAX_POSTS_PER_DAY=3
MIN_HOURS_BETWEEN_POSTS=4
MAX_SOURCE_VIDEO_AGE_DAYS=30
KEEP_CLIPS_DAYS=60
KEEP_SOURCE_VIDEOS_DAYS=7

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
HEALTHCHECKS_IO_URL=        # For cron monitoring